<Page x:Class="TajsTokens.App.Pages.UsagePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Padding="0" RowSpacing="12">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel Spacing="4"><TextBlock Text="Recorded Codex activity · this computer only · independent of quota forecasts" Opacity="0.7" TextWrapping="Wrap"/><TextBlock x:Name="SummaryText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
<ComboBox x:Name="RangeCombo" Header="History" SelectedIndex="2" SelectionChanged="OnQueryChanged" Width="140"><ComboBoxItem Content="24 hours" Tag="1"/><ComboBoxItem Content="7 days" Tag="7"/><ComboBoxItem Content="30 days" Tag="30"/><ComboBoxItem Content="90 days" Tag="90"/><ComboBoxItem Content="All retained" Tag="all"/></ComboBox>
<ComboBox x:Name="ViewCombo" Header="Group by" SelectedIndex="0" SelectionChanged="OnQueryChanged" Width="140"><ComboBoxItem Content="Models" Tag="Model"/><ComboBoxItem Content="Projects" Tag="Session repository"/><ComboBoxItem Content="Sessions" Tag="Session"/><ComboBoxItem Content="Hourly" Tag="Hour"/><ComboBoxItem Content="Daily" Tag="Day"/><ComboBoxItem Content="Monthly" Tag="Month"/></ComboBox>
<ComboBox x:Name="SortCombo" Header="Sort" SelectedIndex="0" SelectionChanged="OnViewChanged" Width="130"><ComboBoxItem Content="Most tokens"/><ComboBoxItem Content="Name / date"/></ComboBox>
<Button Content="Refresh" Click="OnRefreshClicked" VerticalAlignment="Bottom"/><Button Content="Clear filters" Click="OnClearClicked" VerticalAlignment="Bottom"/>
</StackPanel>
<Grid Grid.Row="2" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Loading…" TextWrapping="Wrap" Opacity="0.75" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="SearchBox" PlaceholderText="Find in these rows" TextChanged="OnSearchChanged"/></Grid>
<ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
<Grid MinWidth="1030" RowSpacing="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Grid Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Name / period (UTC)"/><TextBlock Grid.Column="1" Text="Input¹"/><TextBlock Grid.Column="2" Text="Output²"/><TextBlock Grid.Column="3" Text="Cache read"/><TextBlock Grid.Column="4" Text="Cache write"/><TextBlock Grid.Column="5" Text="Reasoning²"/><TextBlock Grid.Column="6" Text="Total"/><TextBlock Grid.Column="7" Text="Sessions"/></Grid>
<ListView Grid.Row="1" x:Name="RowsList" SelectionMode="Single" SelectionChanged="OnRowSelected">
<ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
<ListView.ItemTemplate><DataTemplate><Grid Padding="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding Label}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding InputText}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding OutputText}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding CacheText}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="4" Text="{Binding WriteText}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="5" Text="{Binding ReasoningText}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="6" Text="{Binding TotalText}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="7" Text="{Binding Sessions}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate>
</ListView></Grid></ScrollViewer>
<StackPanel Grid.Row="4" Spacing="6"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="DrillButton" Content="Explore selected usage" Click="OnDrillClicked" IsEnabled="False"/><Button x:Name="OpenThreadButton" Content="Open thread" Click="OnOpenThreadClicked" IsEnabled="False"/></StackPanel><TextBlock x:Name="DetailText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock Text="¹ Input excludes cache reads. ² Output excludes reasoning: all five buckets are disjoint. No API-price estimate or subscription spend is inferred. Time groups use UTC; only recorded activity is shown." TextWrapping="Wrap" Opacity="0.65"/></StackPanel>
</Grid></Page>
