<Page
    x:Class="TajsTokens.App.Pages.CodexCliHarnessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24"
                    Spacing="16"
                    MaxWidth="1180"
                    HorizontalAlignment="Left">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="Codex CLI Harness"
                               FontSize="28"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Run a custom Codex CLI locally while keeping TajsTokens' observability, quota, analytics, and source-explorer features alongside it."
                               Opacity="0.72"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               Opacity="0.72"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Top">
                    <Button x:Name="SaveButton"
                            Content="Save configuration"
                            Click="OnSaveClicked" />
                    <Button x:Name="RunButton"
                            Content="Run"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="OnRunClicked" />
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            IsEnabled="False"
                            Click="OnCancelClicked" />
                </StackPanel>
            </Grid>

            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="Local, on-demand harness"
                     Message="The CLI runs only after Run. Prompt text, stdout, and stderr are displayed in this session and are not written to the TajsTokens telemetry database." />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <Grid ColumnSpacing="18"
                      RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.9*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Command"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1"
                               Text="Arguments"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="CommandBox"
                             Grid.Row="1"
                             Header="Executable or PATH command"
                             PlaceholderText="codex or C:\Tools\custom-codex.exe" />
                    <TextBox x:Name="ArgumentsBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             Header="One argument per line"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="92"
                             PlaceholderText="exec&#xA;--json" />
                    <TextBox x:Name="WorkingDirectoryBox"
                             Grid.Row="2"
                             Header="Working directory (optional)"
                             PlaceholderText="Inherited when empty" />
                    <Grid Grid.Row="2"
                          Grid.Column="1"
                          ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="PromptModeCombo"
                                  Header="Prompt transport"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Standard input" Tag="StandardInput" />
                            <ComboBoxItem Content="Final argument" Tag="LastArgument" />
                            <ComboBoxItem Content="Do not send a prompt" Tag="None" />
                        </ComboBox>
                        <NumberBox x:Name="TimeoutBox"
                                   Grid.Column="1"
                                   Header="Timeout (seconds)"
                                   Minimum="5"
                                   Maximum="3600"
                                   SmallChange="15"
                                   SpinButtonPlacementMode="Compact" />
                    </Grid>
                    <TextBlock Grid.Row="3"
                               Text="Use a fully qualified executable path for a custom build, or a command name available on PATH. Arguments are values, not shell syntax."
                               Opacity="0.68"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Text="The prompt transport is a harness choice; TajsTokens does not assume a universal custom-CLI protocol."
                               Opacity="0.68"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <TextBox x:Name="PromptBox"
                     Header="Prompt"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="150"
                     PlaceholderText="Enter the prompt for this local CLI run..." />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="stdout"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="StdoutBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 MinHeight="260"
                                 IsTextPredictionEnabled="False"
                                 PlaceholderText="Standard output will appear here." />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="stderr"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="StderrBox"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 MinHeight="260"
                                 IsTextPredictionEnabled="False"
                                 PlaceholderText="Standard error will appear here." />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
