<Page
    x:Class="TajsTokens.App.Pages.CodexPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="NavigationItemTemplate">
            <StackPanel Padding="2,5" Spacing="2">
                <TextBlock Text="{Binding Content.DisplayName}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Content.Subtitle}"
                           Opacity="0.65"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ConversationItemTemplate">
            <Expander IsExpanded="{Binding IsExpandedByDefault}"
                      Margin="0,3"
                      HorizontalAlignment="Stretch">
                <Expander.Header>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding TurnId}"
                                   Opacity="0.55"
                                   FontFamily="Consolas"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding NativeType}"
                                   Opacity="0.62"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding RolloutOrdinal}"
                                   Opacity="0.55"
                                   FontFamily="Consolas" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="7" Padding="8,4,4,8">
                    <TextBlock Text="{Binding Body}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                    <ItemsControl ItemsSource="{Binding Facts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="10" Padding="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Opacity="0.62" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Value}"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Open linked thread"
                            Tag="{Binding LinkedThreadId}"
                            Click="OnLinkedThreadClicked"
                            HorizontalAlignment="Left" />
                    <Expander Header="Raw source JSON" IsExpanded="False">
                        <TextBlock Text="{Binding Source.ItemJson}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" />
                    </Expander>
                    <TextBlock Text="{Binding SourceDescription}"
                               Opacity="0.55"
                               FontSize="11"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SourcePath}"
                               Opacity="0.48"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Codex" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="One readable view of local Codex usage, workspaces, threads, subagents and source-native history. Content is inspected on demand and is not copied into TajsTokens storage."
                           Opacity="0.72" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" Text="Loading Codex…" Opacity="0.72" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <StackPanel Spacing="2">
                    <TextBlock Text="Usage range" FontSize="11" Opacity="0.7" />
                    <ComboBox x:Name="RangeCombo" Width="128" SelectedIndex="1"
                              ToolTipService.ToolTip="How far back the usage totals and timeline look."
                              SelectionChanged="OnUsageControlsChanged">
                        <ComboBoxItem Content="Last 24 hours" Tag="1" />
                        <ComboBoxItem Content="Last 7 days" Tag="7" />
                        <ComboBoxItem Content="Last 30 days" Tag="30" />
                        <ComboBoxItem Content="Last 90 days" Tag="90" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Spacing="2">
                    <TextBlock Text="Timeline bucket" FontSize="11" Opacity="0.7" />
                    <ComboBox x:Name="BucketCombo" Width="112" SelectedIndex="1"
                              ToolTipService.ToolTip="The resolution of each timeline and heatmap entry."
                              SelectionChanged="OnUsageControlsChanged">
                        <ComboBoxItem Content="Per minute" Tag="Minute" />
                        <ComboBoxItem Content="Per hour" Tag="Hour" />
                        <ComboBoxItem Content="Per day" Tag="Day" />
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="ArchivedCheckBox" Content="Include archived" VerticalAlignment="Bottom"
                          ToolTipService.ToolTip="Show archived threads in the navigation tree."
                          Checked="OnArchivedChanged" Unchecked="OnArchivedChanged" />
                <Button x:Name="OpenNavigationButton" Content="Browse" Click="OnOpenNavigationClicked" Visibility="Collapsed" />
                <Button Content="Refresh" Click="OnRefreshClicked" />
            </StackPanel>
        </Grid>

        <SplitView x:Name="BrowserSplitView"
                   Grid.Row="1"
                   DisplayMode="Inline"
                   IsPaneOpen="True"
                   OpenPaneLength="330"
                   CompactPaneLength="0"
                   PanePlacement="Left">
            <SplitView.Pane>
            <Border Padding="12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Codex navigation" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Projects use explicit assignments; Workspace groups are the source-native cwd fallback."
                                   Opacity="0.68" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox x:Name="SearchTextBox"
                             Grid.Row="1"
                             PlaceholderText="Search threads, workspace, model or branch"
                             TextChanged="OnSearchChanged" />
                    <TreeView x:Name="NavigationTree"
                              Grid.Row="2"
                              ItemTemplate="{StaticResource NavigationItemTemplate}"
                              SelectionChanged="OnNavigationSelectionChanged"
                              SelectionMode="Single"
                              ScrollViewer.IsDeferredScrollingEnabled="True" />
                </Grid>
            </Border>
            </SplitView.Pane>
            <SplitView.Content>
            <Border Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ScrollViewer x:Name="DetailScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" Spacing="12">
                        <TextBlock Text="Select All Codex, a workspace, or a thread to begin."
                                   TextWrapping="Wrap"
                                   Opacity="0.72" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>
