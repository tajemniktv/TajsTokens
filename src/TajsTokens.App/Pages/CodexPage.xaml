<Page
    x:Class="TajsTokens.App.Pages.CodexPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="NavigationItemTemplate">
            <StackPanel Padding="2,5" Spacing="2">
                <TextBlock Text="{Binding Content.DisplayName}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Content.Subtitle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="BrowserHeading" Spacing="4">
                <TextBlock Text="Codex" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Explore your work or see where your tokens went. Local Codex history on this computer."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" Text="Loading Codex…" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel x:Name="BrowserControls" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Expander Header="Work summary" VerticalAlignment="Top">
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Summary history" Style="{StaticResource CaptionStyle}" />
                            <ComboBox x:Name="RangeCombo" Width="128" SelectedIndex="1"
                                      ToolTipService.ToolTip="How far back the usage totals and timeline look."
                                      SelectionChanged="OnUsageControlsChanged">
                                <ComboBoxItem Content="Last 24 hours" Tag="1" />
                                <ComboBoxItem Content="Last 7 days" Tag="7" />
                                <ComboBoxItem Content="Last 30 days" Tag="30" />
                                <ComboBoxItem Content="Last 90 days" Tag="90" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Summary time groups" Style="{StaticResource CaptionStyle}" />
                            <ComboBox x:Name="BucketCombo" Width="112" SelectedIndex="1"
                                      ToolTipService.ToolTip="The resolution of each timeline and heatmap entry."
                                      SelectionChanged="OnUsageControlsChanged">
                                <ComboBoxItem Content="Per minute" Tag="Minute" />
                                <ComboBoxItem Content="Per hour" Tag="Hour" />
                                <ComboBoxItem Content="Per day" Tag="Day" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Expander>
                <CheckBox x:Name="ArchivedCheckBox" Content="Include archived" VerticalAlignment="Bottom"
                          ToolTipService.ToolTip="Show archived threads in the navigation tree."
                          Checked="OnArchivedChanged" Unchecked="OnArchivedChanged" />
                <Button x:Name="OpenNavigationButton" Content="Browse" Click="OnOpenNavigationClicked" Visibility="Collapsed" />
                <Button Content="Refresh" Click="OnRefreshClicked" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <ToggleButton x:Name="WorkViewButton" Content="Work &amp; threads" IsChecked="True" Click="OnWorkViewClicked" />
            <ToggleButton x:Name="UsageViewButton" Content="Usage breakdown" Click="OnUsageViewClicked" />
        </StackPanel>
        <ContentControl x:Name="UsageHost" Grid.Row="2" Visibility="Collapsed" HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
        <SplitView x:Name="BrowserSplitView"
                   Grid.Row="2"
                   DisplayMode="Inline"
                   IsPaneOpen="True"
                   OpenPaneLength="330"
                   CompactPaneLength="0"
                   PanePlacement="Left">
            <SplitView.Pane>
                <Border Padding="12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Codex navigation" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Projects and threads from your local Codex history."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBox x:Name="SearchTextBox"
                                 Grid.Row="1"
                                 PlaceholderText="Search threads, workspace, model or branch"
                                 TextChanged="OnSearchChanged" />
                        <TreeView x:Name="NavigationTree"
                                  Grid.Row="2"
                                  ItemTemplate="{StaticResource NavigationItemTemplate}"
                                  SelectionChanged="OnNavigationSelectionChanged"
                                  SelectionMode="Single"
                                  ScrollViewer.IsDeferredScrollingEnabled="True" />
                    </Grid>
                </Border>
            </SplitView.Pane>
            <SplitView.Content>
                <Border Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <ScrollViewer x:Name="DetailScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailPanel" Spacing="12">
                            <TextBlock Text="Select All Codex, a workspace, or a thread to begin."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </SplitView.Content>
        </SplitView>
    </Grid>
</Page>