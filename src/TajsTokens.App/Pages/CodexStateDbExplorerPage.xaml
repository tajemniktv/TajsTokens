<Page
    x:Class="TajsTokens.App.Pages.CodexStateDbExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Codex State DB Explorer" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Raw, read-only inspection of discovered Codex SQLite databases. Values stay source-shaped and are never imported into TajsTokens semantics."
                           Opacity="0.72" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusText" Text="Discovering state databases…" Opacity="0.78" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Content="Refresh" Click="OnRefreshClicked" />
                <Button Content="Capture baseline" Click="OnCaptureBaselineClicked" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Inspecting:" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ComboBox x:Name="DatabaseComboBox" Grid.Column="1" SelectionChanged="OnDatabaseSelectionChanged"
                          DisplayMemberPath="DisplayName" PlaceholderText="No Codex SQLite files discovered" />
                <TextBlock x:Name="DatabasePathText" Grid.Row="1" Grid.ColumnSpan="3" Text="No database selected" Opacity="0.72" TextWrapping="Wrap" />
                <TextBlock Grid.Column="2" Text="Read-only · query_only" Opacity="0.72" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="270" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <Border Padding="12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Tables and views" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="TableCountText" Text="—" Opacity="0.68" />
                    </StackPanel>
                    <ComboBox x:Name="FocusedTableComboBox" Grid.Row="1" Header="Focused raw views"
                              PlaceholderText="All discovered tables" DisplayMemberPath="Name"
                              SelectionChanged="OnFocusedTableChanged" />
                    <ListView x:Name="TableList" Grid.Row="2" SelectionMode="Single" SelectionChanged="OnTableSelectionChanged"
                              ScrollViewer.IsDeferredScrollingEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="3,6" Spacing="2">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding ObjectType}" Opacity="0.62" />
                                    </Grid>
                                    <TextBlock Text="{Binding RowCountSummary}" Opacity="0.74" />
                                    <TextBlock Text="{Binding ColumnSummary}" Opacity="0.62" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="SelectedTableText" Text="Select a table or view" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectedTableSchemaText" Text="Schema, columns, indexes and raw rows appear here." Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <Expander Grid.Row="1" Header="Columns and indexes" IsExpanded="False">
                        <StackPanel Padding="4,6" Spacing="4">
                            <TextBlock x:Name="ColumnsText" Text="—" TextWrapping="Wrap" />
                            <TextBlock x:Name="IndexesText" Text="—" Opacity="0.72" TextWrapping="Wrap" />
                            <TextBlock x:Name="SqlText" Text="—" FontFamily="Consolas" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Content="‹ Previous" Click="OnPreviousPageClicked" />
                        <Button Grid.Column="1" Content="Next ›" Click="OnNextPageClicked" />
                        <TextBlock x:Name="PageSummaryText" Grid.Column="2" Text="No rows loaded" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Button Grid.Column="3" Content="Copy selected (sanitized)" Click="OnCopyClicked" />
                        <Button Grid.Column="4" Content="Export page (sanitized)" Click="OnExportClicked" />
                    </Grid>
                    <Grid Grid.Row="3" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ScrollViewer x:Name="RawScrollViewer" Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      ZoomMode="Disabled">
                            <Grid x:Name="RawGrid" />
                        </ScrollViewer>
                    </Grid>
                    <Border Grid.Row="4" Padding="8" CornerRadius="8" Background="{ThemeResource SubtleFillColorTransparentBrush}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Baseline diff" FontWeight="SemiBold" />
                            <TextBlock x:Name="BaselineText" Text="No baseline captured. Capture one, then refresh to compare source tables and bounded row fingerprints." Opacity="0.72" TextWrapping="Wrap" />
                            <ListView x:Name="DiffList" MaxHeight="120" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Summary}" Opacity="0.72" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
