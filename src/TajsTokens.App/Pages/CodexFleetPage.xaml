<Page
    x:Class="TajsTokens.App.Pages.CodexFleetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="4" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Local Codex fleet" FontSize="22" FontWeight="SemiBold" />
                <Button Content="Refresh local" Click="OnRefreshClicked" />
                <Button Content="Check SSH hosts" Click="OnRemoteRefreshClicked" />
            </StackPanel>
            <TextBlock Text="Local rows refresh every 15 seconds while open. SSH hosts are checked only when you click Check SSH hosts; your key may require a hardware-key touch. Recent in-progress history is not process-liveness proof; waiting for input cannot be verified from these local sources. Token figures are collected session totals, not per-turn cost or quota share."
                       Opacity="0.72" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" Text="Reading local Codex fleet…" Opacity="0.8" TextWrapping="Wrap" />
        </StackPanel>
        <ListView x:Name="FleetList" Grid.Row="1" SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged" ScrollViewer.IsDeferredScrollingEnabled="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="8" Spacing="3">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding StateLine}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding UsageLine}" Opacity="0.72" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EvidenceLine}" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
