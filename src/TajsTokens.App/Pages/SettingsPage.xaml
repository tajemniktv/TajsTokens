<Page
    x:Class="TajsTokens.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24"
                    Spacing="18"
                    MaxWidth="920"
                    HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock Text="Runtime behavior, collection cadence, notifications, and local data settings. Changes are persisted under LocalAppData."
                           Opacity="0.75"
                           TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar x:Name="StatusInfoBar"
                     IsOpen="False"
                     IsClosable="True" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="General"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="RunInBackgroundToggle"
                                  Header="Keep TajsTokens running in the background"
                                  OffContent="Exit when the dashboard closes"
                                  OnContent="Continue collecting after the dashboard closes" />
                    <ToggleSwitch x:Name="LaunchAtLoginToggle"
                                  Header="Start with Windows"
                                  OffContent="Manual start"
                                  OnContent="Launch TajsTokens at sign-in" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Collection"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <NumberBox x:Name="PollIntervalBox"
                               Header="Refresh interval (seconds)"
                               Minimum="15"
                               Maximum="3600"
                               SmallChange="15"
                               SpinButtonPlacementMode="Compact" />
                    <TextBlock Text="The process-lifetime collector restarts with the new cadence immediately after saving. Native Codex state/rollout collection is incremental, so warm idle refreshes should perform effectively no historical rollout work."
                               Opacity="0.75"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Notifications"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="NotificationsToggle"
                                  Header="Desktop notifications"
                                  OffContent="Muted"
                                  OnContent="Enabled" />
                    <TextBox x:Name="ThresholdsTextBox"
                             Header="Low-quota thresholds (%)"
                             PlaceholderText="30, 20, 10, 5" />
                    <TextBlock Text="Comma, semicolon, or space separated. Values must be between 1 and 99; duplicates are removed."
                               Opacity="0.75"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Sources"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Codex app-server"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Provider-authoritative quota source."
                               Opacity="0.75" />
                    <TextBlock Text="Native Codex state + rollouts"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Default token/session source. TajsTokens incrementally normalizes local Codex state and rollouts; remote/cloud-only sessions are explicitly outside this coverage until that source exists."
                               Opacity="0.75"
                               TextWrapping="Wrap" />
                    <ToggleSwitch x:Name="TokscaleReconciliationToggle"
                                  Header="Reconcile native accounting with Tokscale"
                                  OffContent="Disabled · no Tokscale process"
                                  OnContent="Run Tokscale as an optional comparison oracle" />
                    <ToggleSwitch x:Name="TokscaleFallbackToggle"
                                  Header="Allow Tokscale fallback"
                                  OffContent="Native failure stays visible as unavailable/stale"
                                  OnContent="Use Tokscale only if native accounting fails" />
                    <TextBlock Text="Both Tokscale options are disabled by default. Enabling either can launch the Tokscale CLI (or its npx fallback); normal collection no longer requires Node.js, npm, or Tokscale."
                               Opacity="0.75"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Privacy &amp; storage"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Application data folder"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DataFolderText"
                               FontFamily="Consolas"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Telemetry database"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <TextBlock x:Name="DatabasePathText"
                               FontFamily="Consolas"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SettingsSchemaText"
                               Opacity="0.7"
                               Margin="0,6,0,0" />
                    <TextBlock Text="TajsTokens stores normalized content-free telemetry here. Provider-owned rollout paths and raw prompt/tool payloads are not copied into the normal telemetry surface."
                               Opacity="0.75"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="SaveButton"
                        Content="Save settings"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnSaveClicked" />
                <Button Content="Reload"
                        Click="OnReloadClicked" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>