<Page
    x:Class="TajsTokens.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24"
                    Spacing="18"
                    MaxWidth="920"
                    HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock
                    Text="Runtime behavior, collection cadence, notifications, and local data settings. Changes are persisted under LocalAppData."
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <TextBlock x:Name="BuildVersionText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar x:Name="StatusInfoBar"
                     IsOpen="False"
                     IsClosable="True" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <StackPanel Spacing="14">
                    <TextBlock Text="General"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="RunInBackgroundToggle"
                                  Header="Keep TajsTokens running in the background"
                                  OffContent="Exit when the dashboard closes"
                                  OnContent="Continue collecting after the dashboard closes" />
                    <ToggleSwitch x:Name="LaunchAtLoginToggle"
                                  Header="Start with Windows"
                                  OffContent="Manual start"
                                  OnContent="Launch TajsTokens at sign-in" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Local limits API" FontSize="20" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="LocalLimitsApiToggle"
                                  Header="Enable read-only API for local tools"
                                  OffContent="Disabled (default)"
                                  OnContent="Loopback only; bearer token required" />
                    <NumberBox x:Name="LocalLimitsApiPortBox" Header="Loopback port" Minimum="1024" Maximum="65535"
                               SmallChange="1" SpinButtonPlacementMode="Compact" />
                    <TextBlock x:Name="LocalLimitsApiStatusText" TextWrapping="Wrap" />
                    <Button Content="Copy access token" Click="OnCopyLocalApiTokenClicked" HorizontalAlignment="Left" />
                    <TextBlock Text="GET /v1/limits returns existing quota lanes with source and freshness. It does not trigger collection. The token is stored in this user's settings.json; keep it private. Browser origins are rejected and no cross-origin access is granted."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Collection"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <NumberBox x:Name="PollIntervalBox"
                               Header="Refresh interval (seconds)"
                               Minimum="15"
                               Maximum="3600"
                               SmallChange="15"
                               SpinButtonPlacementMode="Compact" />
                    <TextBlock Text="Changes take effect when saved. Collection reads new local activity without modifying Codex's files."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Notifications"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="NotificationsToggle"
                                  Header="Desktop notifications"
                                  OffContent="Muted"
                                  OnContent="Enabled" />
                    <TextBox x:Name="ThresholdsTextBox"
                             Header="Low-quota thresholds (%)"
                             PlaceholderText="30, 20, 10, 5" />
                    <TextBlock Text="Comma, semicolon, or space separated. Values must be between 1 and 99; duplicates are removed."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Sources"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Codex app-server"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Provider-authoritative quota source."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Native Codex state + rollouts"
                               FontWeight="SemiBold" />
                    <TextBlock
                        Text="Default token/session source. TajsTokens incrementally normalizes local Codex state and rollouts; remote/cloud-only sessions remain outside local token accounting. The SSH fleet probe below shows remote status separately."
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <Expander Header="Observed quota accounts and sources" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ObservedAccountsText" Text="Loading retained observations…"
                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <TextBlock Text="Historical source keys stay with their original observations. A key is a backend pseudonym, not proof that local Codex threads belong to that account."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                    <TextBox x:Name="RemoteFleetHostsBox"
                             Header="Optional remote thread status via SSH (one host alias per line)"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76"
                             PlaceholderText="laptop&#xA;server" />
                    <TextBlock Text="Account-wide Codex quota is read on this PC and does not require SSH or TajsTokens on other machines. These optional, read-only probes fetch only remote local thread status when you select the SSH button in Live fleet. Hardware-backed keys may require a touch. Python 3 and Codex history must be available to the SSH user. Successful host-qualified status snapshots are retained locally; no transcript bodies, quota readings or credentials are copied or merged."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Expander Header="Advanced integrations" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="12">
                            <ToggleSwitch x:Name="TokscaleReconciliationToggle"
                                          Header="Reconcile native accounting with Tokscale"
                                          OffContent="Disabled · no Tokscale process"
                                          OnContent="Run Tokscale as an optional comparison oracle" />
                            <ToggleSwitch x:Name="TokscaleFallbackToggle"
                                          Header="Allow Tokscale fallback"
                                          OffContent="Native failure stays visible as unavailable/stale"
                                          OnContent="Use Tokscale only if native accounting fails" />
                            <TextBlock
                                Text="Both Tokscale options are disabled by default. Enabling either can launch the Tokscale CLI (or its npx fallback); normal collection no longer requires Node.js, npm, or Tokscale."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <StackPanel Spacing="10">
                    <Expander Header="Advanced · CLI harness defaults" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <TextBox x:Name="CodexCliCommandBox"
                                     Header="Executable or PATH command"
                                     PlaceholderText="codex or C:\Tools\custom-codex.exe" />
                            <TextBox x:Name="CodexCliArgumentsBox"
                                     Header="Arguments (one per line)"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="90"
                                     PlaceholderText="exec&#xA;--json" />
                            <TextBox x:Name="CodexCliWorkingDirectoryBox"
                                     Header="Working directory (optional)"
                                     PlaceholderText="Leave empty to inherit TajsTokens' working directory" />
                            <ComboBox x:Name="CodexCliPromptModeCombo"
                                      Header="Prompt transport"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Standard input" Tag="StandardInput" />
                                <ComboBoxItem Content="Final argument" Tag="LastArgument" />
                                <ComboBoxItem Content="Do not send a prompt" Tag="None" />
                            </ComboBox>
                            <NumberBox x:Name="CodexCliTimeoutBox"
                                       Header="Harness timeout (seconds)"
                                       Minimum="5"
                                       Maximum="3600"
                                       SmallChange="15"
                                       SpinButtonPlacementMode="Compact" />
                            <TextBlock
                                Text="The harness runs only when you press Run. Prompt text, stdout, and stderr remain in the current app session and are not written to the telemetry database. Keep credentials out of persisted arguments; use the CLI's normal secure authentication flow."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Privacy &amp; storage"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Application data folder"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="DataFolderText"
                               FontFamily="Consolas"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Telemetry database"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                    <TextBlock x:Name="DatabasePathText"
                               FontFamily="Consolas"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SettingsSchemaText"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,6,0,0" />
                    <TextBlock
                        Text="TajsTokens retains selected content-free observations and local source paths, not prompt, reasoning, or tool bodies. There is no automatic age-based cleanup. Replaced rollout generations can rebuild accounting projections; preserve backups for recovery. Native source data remains read-only."
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock Text="Historical rollout ownership" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="RolloutOwnershipText" TextWrapping="Wrap" />
                <TextBlock
                    Text="Associate retained rollout history with a recorded account as your assertion, without changing native account IDs. This is bounded to existing source/session histories; new activity is not automatically included. Live-collected validation is still required for model promotion."
                    TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="AssociateRolloutsButton" Content="Associate retained histories…" Click="OnAssociateRolloutsClicked" />
                    <Button x:Name="RevokeRolloutsButton" Content="Revoke associations" Click="OnRevokeRolloutsClicked" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="SaveButton"
                        Content="Save settings"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnSaveClicked" />
                <Button Content="Reload"
                        Click="OnReloadClicked" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
