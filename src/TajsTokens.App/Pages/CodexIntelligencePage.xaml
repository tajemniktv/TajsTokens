<Page x:Class="TajsTokens.App.Pages.CodexIntelligencePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Codex overview" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Your allowance, the work behind it, and what comes next." Style="{StaticResource SubtitleStyle}" />
                <TextBlock x:Name="StatusText" Style="{StaticResource CaptionStyle}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh view" Click="OnApply" VerticalAlignment="Center" />
        </Grid>
        <ScrollViewer Grid.Row="1" MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="DashboardCards" ColumnSpacing="16" RowSpacing="16" SizeChanged="OnDashboardSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition x:Name="OutlookColumn" Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Account allowances · now" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="AccountScopeText" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock x:Name="QuotaEmpty" Text="Waiting for a reported quota reading."
                                               Style="{StaticResource CaptionStyle}" />
                                    <ItemsControl x:Name="QuotaTiles">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="{Binding Width}" Spacing="6" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" Style="{StaticResource SubtitleStyle}" />
                                                    <TextBlock Text="{Binding Remaining}" FontSize="24" FontWeight="SemiBold" />
                                                    <ProgressBar Value="{Binding Value}" Visibility="{Binding MeterVisibility}" Minimum="0" Maximum="100"
                                                                 AutomationProperties.Name="Quota remaining percent" />
                                                    <TextBlock Text="{Binding Reset}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Pace}" Style="{StaticResource CaptionStyle}" />
                                                    <TextBlock Text="{Binding Freshness}" Style="{StaticResource CaptionStyle}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <HyperlinkButton Content="See quota evidence" Click="OnEvidence" HorizontalAlignment="Left" Padding="0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="OutlookCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Does this pace last?" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="OutlookValue" Text="Checking allowance context" FontSize="22" FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="OutlookDetail" Text="A current, compatible forecast will appear here."
                                               TextWrapping="Wrap" />
                                    <Button Content="Plan another work session" Click="OnPlan" HorizontalAlignment="Left" />
                                    <HyperlinkButton Content="Forecast details and uncertainty" Click="OnPlan" HorizontalAlignment="Left"
                                                     Padding="0" />
                                </StackPanel>
                            </Border>
                        </Grid>
        </ScrollViewer>
        <Expander x:Name="SelectionExpander" Grid.Row="2" Header="History range and filters" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch">
            <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Today" Tag="1" Click="OnQuickRange" />
                    <Button Content="Last 7 days" Tag="7" Click="OnQuickRange" />
                    <Button Content="Last 30 days" Tag="30" Click="OnQuickRange" />
                    <Button Content="Clear work filters" Click="OnClearFilters" />
                </StackPanel>
                <TextBlock
                    Text="UTC dates · end date exclusive. Work filters affect history below; live account allowances stay separate."
                    Style="{StaticResource CaptionStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <CalendarDatePicker x:Name="FromDate" Header="From" /><CalendarDatePicker x:Name="ToDate" Header="Until" />
                    <Button Content="Apply selection" Click="OnApply" VerticalAlignment="Bottom" />
                </StackPanel>
                <ComboBox x:Name="Account" Header="Account scope" SelectionChanged="OnAccountChanged" HorizontalAlignment="Stretch" />
                <TextBox x:Name="Model" Header="Model" PlaceholderText="All models" />
                <TextBox x:Name="Project" Header="Project" PlaceholderText="All projects — exact path to filter" />
                <TextBox x:Name="Thread" Header="Chat" PlaceholderText="All chats — ID to filter" />
            </StackPanel>
            </ScrollViewer>
        </Expander>
        <TabView Grid.Row="3" x:Name="Views" IsAddTabButtonVisible="False" TabWidthMode="SizeToContent" SelectionChanged="OnViewChanged">
            <TabViewItem Header="Overview" IsClosable="False">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="18" Padding="0,16,12,20">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="The work behind your usage" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock x:Name="WorkRange" Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                    <HyperlinkButton Grid.Column="1" Content="Explore work" Click="OnHistory" />
                                </Grid>
                                <TextBlock x:Name="WorkValue" Style="{StaticResource HeroMetricStyle}" />
                                <TextBlock x:Name="TtValue" Style="{StaticResource HeroMetricStyle}" />
                                <TextBlock x:Name="TtBasisLabel" Style="{StaticResource CaptionStyle}" />
                                <TextBlock x:Name="WorkDetail" Style="{StaticResource SubtitleStyle}" />
                                <TextBlock x:Name="NowcastSummary" Style="{StaticResource SubtitleStyle}" />
                                <HyperlinkButton Content="Inspect quota changes" Click="OnQuotaHistory" HorizontalAlignment="Left" />
                                <Canvas x:Name="Timeline" Height="180" SizeChanged="OnTimelineSizeChanged"
                                        AutomationProperties.Name="Observed workload over the selected UTC range" />
                                <TextBlock x:Name="TimelineLegend" Style="{StaticResource CaptionStyle}" />
                                <TextBlock
                                    Text="Workload and account quota are connected, but tokens are not a quota currency. Forecasts use the compatible evidence available."
                                    Style="{StaticResource CaptionStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Work history" IsClosable="False">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16" Padding="0,16,12,20">
                        <TextBlock Text="Where the work went" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="SummaryText" Style="{StaticResource SubtitleStyle}" />
                        <ComboBox x:Name="Dimension" Header="Break down by" SelectedIndex="0" SelectionChanged="OnDimensionChanged">
                            <x:String>Model</x:String><x:String>Effort</x:String><x:String>Token type</x:String>
                            <x:String>Project</x:String><x:String>Chat</x:String>
                        </ComboBox>
                        <ListView x:Name="Groups" MaxHeight="480">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="8" Spacing="4">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Filter to selected row" Click="OnFilterGroup" />
                            <Button Content="Open chats and agents" Click="OnBrowse" />
                        </StackPanel>
                        <Expander Header="Timeline values and quota observations" HorizontalContentAlignment="Stretch"
                                  HorizontalAlignment="Stretch">
                            <TextBlock x:Name="TimelineText" Style="{StaticResource TechnicalTextStyle}" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Planning" IsClosable="False">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16" Padding="0,16,12,20" MaxWidth="1000" HorizontalAlignment="Left">
                        <TextBlock Text="Will my next session fit?" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="PlanMeasuredWork" Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="A conditional account-wide scenario. Work-history filters below the live header do not allocate quota to projects or chats."
                                   Style="{StaticResource SubtitleStyle}" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <NumberBox x:Name="PlanHours" Header="Duration (hours)" Value="1" Minimum="0.05" Maximum="168" ValueChanged="OnPlanNumberChanged" />
                                <AutoSuggestBox x:Name="PlanModel" Header="Model · optional exact name" TextChanged="OnPlanTextChanged" />
                                <AutoSuggestBox x:Name="PlanEffort" Header="Reasoning effort · optional" TextChanged="OnPlanTextChanged" />
                                <TextBlock x:Name="ModelDiscoveryText" Text="Model access is unverified." Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap" />
                                <Button x:Name="RecentPatternButton" Content="Use recent local work pattern" Click="OnRecentPattern" />
                                <TextBlock x:Name="RecentPatternText" Text="Optional editable suggestion from recent local activity; it does not establish account ownership." Style="{StaticResource CaptionStyle}" />
                                <Expander Header="Session counts and history" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="10">
                                        <NumberBox x:Name="PlanRoots" Header="Active root chats" Value="1" Minimum="0" Maximum="32" ValueChanged="OnPlanNumberChanged" />
                                        <NumberBox x:Name="PlanChildren" Header="Active subagents" Value="0" Minimum="0" Maximum="64" ValueChanged="OnPlanNumberChanged" />
                                        <NumberBox x:Name="PlanHistoryDays" Header="History lookback (days)" Value="30" Minimum="1" Maximum="30" ValueChanged="OnPlanNumberChanged" />
                                        <TextBlock Text="Counts mean recently token-active sessions, not simultaneous model computation. History lookback is independent of the work-history range." Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                </Expander>
                                <Button Content="Estimate session fit" Click="OnSimulate" />
                                <TextBlock x:Name="ScenarioText" Text="Choose a session, then estimate its fit against both allowances." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <HyperlinkButton Content="Forecast and workload history" Click="OnForecastHistory" />
                            <HyperlinkButton Content="Model lab" Click="OnModelLab" />
                            <HyperlinkButton Content="Inspect quota changes" Click="OnQuotaHistory" />
                        </StackPanel>
                        <Expander Header="Current forecasts and uncertainty" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch" IsExpanded="True">
                            <TextBlock x:Name="ForecastText" Style="{StaticResource TechnicalTextStyle}" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem Header="Evidence" IsClosable="False">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16" Padding="0,16,12,20">
                        <TextBlock Text="Why these numbers?" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock
                            Text="Sources, coverage and model details for the same selection. Research here does not replace live forecasts."
                            Style="{StaticResource SubtitleStyle}" />
                        <Expander x:Name="QuotaEvidence" Header="Current quota readings" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <TextBlock x:Name="CurrentText" Style="{StaticResource TechnicalTextStyle}" />
                        </Expander>
                        <Expander Header="Coverage and source health" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <TextBlock x:Name="EvidenceText" Style="{StaticResource TechnicalTextStyle}" />
                        </Expander>
                        <Expander x:Name="ReferenceExpander" Header="TT basis and API reference prices" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="ReferenceDetails" Style="{StaticResource TechnicalTextStyle}" />
                                <Button x:Name="SaveTtButton" Content="Save this TT calculation" Click="OnSaveTt" />
                                <ComboBox x:Name="PriceImportRole" Header="Import as" SelectedIndex="0">
                                    <x:String>Official snapshot</x:String><x:String>Local override</x:String><x:String>Community fallback (enable)</x:String>
                                </ComboBox>
                                <Button Content="Import price snapshot…" Click="OnImportPrice" />
                                <Button Content="Disable overrides and fallbacks" Click="OnDisableOptionalPrices" />
                                <Button Content="Enable legacy pinned fallback" Click="OnLegacyPrices" />
                                <Button Content="Select a different TT basis…" Click="OnSelectTtBasis" />
                                <TextBlock Text="Price imports leave TT weights unchanged. Selecting another basis changes future views; saved calculations stay on their original basis. Historical restatements must be explicit."
                                           Style="{StaticResource CaptionStyle}" />
                                <TextBlock x:Name="ReferenceActionStatus" Style="{StaticResource SubtitleStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="Provider reports and historical periods" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <Button Content="Check historical analytics capability" Click="OnCollectHistorical" />
                                <TextBlock x:Name="ProviderText" Style="{StaticResource TechnicalTextStyle}" />
                                <TextBlock x:Name="PeriodsText" Style="{StaticResource TechnicalTextStyle}" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="Accounting and regime research" HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <Button x:Name="AnalyzeButton" Content="Analyze selected history" Click="OnAnalyze" />
                                <TextBlock x:Name="AccountingText" Style="{StaticResource TechnicalTextStyle}" />
                            </StackPanel>
                        </Expander>
                        <Expander Header="Reproducibility manifest" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <TextBlock x:Name="ManifestText" FontFamily="Consolas" Style="{StaticResource TechnicalTextStyle}" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
