<Page
    x:Class="TajsTokens.App.Pages.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="24">
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20"
                MaxWidth="760"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <StackPanel Spacing="10">
                <TextBlock x:Name="TitleBlock"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Text="Planned section" />
                <TextBlock x:Name="DescriptionBlock"
                           Text="This section has an intentional product role, but its dedicated surface is not implemented yet."
                           Opacity="0.85"
                           TextWrapping="Wrap" />
                <InfoBar IsOpen="True"
                         IsClosable="False"
                         Severity="Informational"
                         Message="Overview remains the at-a-glance surface; deeper telemetry belongs here as these sections are implemented." />
            </StackPanel>
        </Border>
    </Grid>
</Page>
