<Page
    x:Class="TajsTokens.App.Pages.CodexSourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Codex Sources" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Provider-native, read-only views of Codex logs, memory, goals, queue, artifacts and Desktop stores. Content-bearing values stay local to this inspection session; choose the shown path in State DB Explorer for deliberate raw inspection."
                           Opacity="0.72" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock x:Name="StatusText" Text="Loading Codex source capabilities…" Opacity="0.72" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" Click="OnRefreshClicked" VerticalAlignment="Top" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBox x:Name="FilterTextBox"
                     PlaceholderText="Filter source rows by thread, status, id or host"
                     TextChanged="OnFilterChanged" />
            <ItemsControl x:Name="SourceStatusList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,8" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Status}" Opacity="0.72" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="180" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>
            <Border Padding="10" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Source families" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Select one source to inspect its bounded observations."
                                   Opacity="0.68" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListView x:Name="SourceList" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnSourceSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="3,7" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Status}" Opacity="0.68" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Column="1" Padding="12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid x:Name="SourceDetailHost">
                    <Grid x:Name="LogsPane" Visibility="Collapsed">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="LogsSourceText" TextWrapping="Wrap" Opacity="0.72" />
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="LogLevelsTextBox" Width="170" PlaceholderText="Levels: ERROR,WARN" />
                            <TextBox x:Name="LogTargetTextBox" Width="220" PlaceholderText="Target contains" />
                            <TextBox x:Name="LogModuleTextBox" Width="220" PlaceholderText="Module path contains" />
                            <TextBox x:Name="LogThreadTextBox" Width="220" PlaceholderText="Thread ID" />
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="LogFromTextBox" Width="250" PlaceholderText="From UTC: ISO-8601 or Unix seconds" />
                            <TextBox x:Name="LogToTextBox" Width="250" PlaceholderText="To UTC (exclusive)" />
                            <TextBox x:Name="LogProcessTextBox" Width="250" PlaceholderText="Process UUID" />
                            <CheckBox x:Name="LogIncludeThreadlessCheckBox" Content="Include threadless" IsChecked="True" VerticalAlignment="Center" />
                            <CheckBox x:Name="LogIncludeMessagesCheckBox" Content="Show log bodies" VerticalAlignment="Center" />
                            <Button Content="Apply" Click="OnLogApplyClicked" />
                            <Button x:Name="LogPreviousButton" Content="Previous" Click="OnLogPreviousClicked" IsEnabled="False" />
                            <Button x:Name="LogNextButton" Content="Next" Click="OnLogNextClicked" IsEnabled="False" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="3" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="LogsQueryStatus" TextWrapping="Wrap" Opacity="0.72" />
                        <ListView x:Name="LogsList" Grid.Row="1" SelectionMode="None" ScrollViewer.IsDeferredScrollingEnabled="True">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
                    </Grid>
                    <Grid x:Name="MemoryPane" Visibility="Collapsed">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock x:Name="MemorySourceText" TextWrapping="Wrap" Opacity="0.72" />
                    <ListView x:Name="MemoryList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" /></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
                    </Grid>
                    <Grid x:Name="GoalsPane" Visibility="Collapsed">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock x:Name="GoalsSourceText" TextWrapping="Wrap" Opacity="0.72" />
                    <ListView x:Name="GoalsList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" /></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
                    </Grid>
                    <Grid x:Name="QueuePane" Visibility="Collapsed">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock x:Name="QueueSourceText" TextWrapping="Wrap" Opacity="0.72" />
                    <ListView x:Name="QueueList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" /></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
                    </Grid>
                    <Grid x:Name="ArtifactsPane" Visibility="Collapsed">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock x:Name="ArtifactsSourceText" TextWrapping="Wrap" Opacity="0.72" />
                    <ListView x:Name="ArtifactsList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" /></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
                    </Grid>
                    <Grid x:Name="CatalogPane" Visibility="Collapsed">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock x:Name="CatalogSourceText" TextWrapping="Wrap" Opacity="0.72" />
                    <ListView x:Name="CatalogList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" /></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
                    </Grid>
                    <Grid x:Name="SummariesPane" Visibility="Collapsed">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock x:Name="SummariesSourceText" TextWrapping="Wrap" Opacity="0.72" />
                    <ListView x:Name="SummariesList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" /></DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
                    </Grid>
                    <TextBlock x:Name="SourceDetailEmptyText"
                               Text="Select a source family."
                               Opacity="0.7"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
