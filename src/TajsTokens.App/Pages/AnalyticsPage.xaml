<Page
    x:Class="TajsTokens.App.Pages.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Intelligence &amp; quota burn microscope" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Inspect provider-observed quota movement alongside native Codex activity, reset/re-anchor history and estimated contributors. Correlation is labelled as correlation because apparently software occasionally deserves epistemic standards."
                           Opacity="0.72" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock x:Name="StatusText" Text="Loading quota intelligence…" Opacity="0.72" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <ComboBox x:Name="RangeCombo" Width="130" SelectedIndex="1">
                    <ComboBoxItem Content="24 hours" Tag="1" />
                    <ComboBoxItem Content="7 days" Tag="7" />
                    <ComboBoxItem Content="30 days" Tag="30" />
                    <ComboBoxItem Content="90 days" Tag="90" />
                </ComboBox>
                <Button Content="Refresh" Click="OnRefreshClicked" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Quota-burn intervals" Opacity="0.65" />
                    <TextBlock x:Name="BurnIntervalCountText" Text="—" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Largest observed drop" Opacity="0.65" />
                    <TextBlock x:Name="LargestDropText" Text="—" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Reset / re-anchor events" Opacity="0.65" />
                    <TextBlock x:Name="ResetCountText" Text="—" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Intervals with local activity" Opacity="0.65" />
                    <TextBlock x:Name="CorrelatedIntervalsText" Text="—" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Padding="12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Provider-observed quota movement" FontSize="18" FontWeight="SemiBold" />
                    <ListView x:Name="BurnIntervalList"
                              Grid.Row="1"
                              SelectionMode="Single"
                              SelectionChanged="OnBurnIntervalSelectionChanged"
                              ScrollViewer.IsDeferredScrollingEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="5" Spacing="2">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Opacity="0.72" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <TabView IsAddTabButtonVisible="False">
                    <TabViewItem Header="Attribution">
                        <Grid RowSpacing="8" Padding="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="SelectedIntervalTitle" Text="Select a quota-burn interval" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="SelectedIntervalFacts" Grid.Row="1" Text="Observed provider facts and estimated local contributors will appear here." Opacity="0.72" TextWrapping="Wrap" />
                            <ListView x:Name="ContributorList" Grid.Row="2" SelectionMode="None" ScrollViewer.IsDeferredScrollingEnabled="True">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="5" Spacing="2">
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Opacity="0.72" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </TabViewItem>
                    <TabViewItem Header="Reset timeline">
                        <ListView x:Name="ResetList" SelectionMode="None" ScrollViewer.IsDeferredScrollingEnabled="True">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="5" Spacing="2">
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Opacity="0.72" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </TabViewItem>
                </TabView>
            </Border>
        </Grid>
    </Grid>
</Page>
