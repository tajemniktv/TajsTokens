<Page x:Class="TajsTokens.App.Pages.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="16">
<VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="BurnDetailColumn.Width" Value="1.6*" />
                                        <Setter Target="BurnDetailRow.Height" Value="0" />
                                        <Setter Target="BurnDetails.(Grid.Row)" Value="0" />
                                        <Setter Target="BurnDetails.(Grid.Column)" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Quota burn" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Inspect quota changes and the local activity recorded alongside them." TextWrapping="Wrap" Opacity="0.7" />
                <TextBlock x:Name="StatusText" Text="Loading quota changes…" TextWrapping="Wrap" Opacity="0.6" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <ComboBox x:Name="RangeCombo" Width="120" SelectedIndex="1" SelectionChanged="OnFilterChanged" AutomationProperties.Name="History range">
                    <ComboBoxItem Content="24 hours" Tag="1" /><ComboBoxItem Content="7 days" Tag="7" />
                    <ComboBoxItem Content="30 days" Tag="30" /><ComboBoxItem Content="90 days" Tag="90" />
                </ComboBox>
                <Button Content="Refresh" Click="OnRefreshClicked" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6"><TextBlock Text="Changes loaded" Opacity="0.65" /><TextBlock x:Name="BurnIntervalCountText" Text="—" FontSize="24" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6"><TextBlock Text="Largest change" Opacity="0.65" /><TextBlock x:Name="LargestDropText" Text="—" FontSize="24" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6"><TextBlock Text="Evidence source" Opacity="0.65" /><TextBlock x:Name="ResetCountText" Text="—" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
            </Border>
            <Border Grid.Column="3" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6"><TextBlock Text="With local activity" Opacity="0.65" /><TextBlock x:Name="CorrelatedIntervalsText" Text="—" FontSize="24" FontWeight="SemiBold" /></StackPanel>
            </Border>
        </Grid>
        <Pivot Grid.Row="2">
            <PivotItem Header="Usage changes">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox x:Name="SourceFilter" SelectedIndex="0" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Quota evidence source">
                            <ComboBoxItem Content="Account meter" /><ComboBoxItem Content="Rollout readings" /><ComboBoxItem Content="All sources · separate" />
                        </ComboBox>
                        <ComboBox x:Name="BurnWindowFilter" SelectedIndex="0" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Quota window">
                            <ComboBoxItem Content="All windows" /><ComboBoxItem Content="5-hour" /><ComboBoxItem Content="Weekly" />
                        </ComboBox>
                    </StackPanel>
                    <Grid Grid.Row="1" x:Name="BurnLayout" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="BurnDetailColumn" Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition x:Name="BurnDetailRow" Height="*" /></Grid.RowDefinitions>

                        <Border Padding="8" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <ListView x:Name="BurnIntervalList" SelectionMode="Single" SelectionChanged="OnBurnIntervalSelectionChanged" ScrollViewer.IsDeferredScrollingEnabled="True" AutomationProperties.Name="Quota changes">
                                <ListView.ItemTemplate><DataTemplate>
                                    <StackPanel Padding="8" Spacing="5">
                                        <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Opacity="0.65" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </Border>
                        <Border x:Name="BurnDetails" Grid.Row="1" Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock x:Name="SelectedIntervalTitle" Text="Select a quota change" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <StackPanel Grid.Row="1" Spacing="6">
                                    <TextBlock x:Name="SelectedIntervalFacts" Text="Its observed change and local activity will appear here." TextWrapping="Wrap" Opacity="0.7" />
                                    <TextBlock Text="Local activity is context, not proof of what caused the quota change." TextWrapping="Wrap" Opacity="0.6" />
                                </StackPanel>
                                <Expander Grid.Row="2" Header="Source and interpretation" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxHeight="180">
                                    <ScrollViewer><TextBlock x:Name="IntervalEvidenceText" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></ScrollViewer>
                                </Expander>
                                <ListView x:Name="ContributorList" Grid.Row="3" SelectionMode="None" ScrollViewer.IsDeferredScrollingEnabled="True" AutomationProperties.Name="Local activity in selected interval">
                                    <ListView.ItemTemplate><DataTemplate>
                                        <StackPanel Padding="8" Spacing="6">
                                            <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <ProgressBar Value="{Binding Share}" Minimum="0" Maximum="100" Height="4" />
                                            <TextBlock Text="{Binding Detail}" Opacity="0.7" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate></ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </PivotItem>
            <PivotItem Header="Reset signals">
                <Grid RowSpacing="12" Padding="4,12,4,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Stored reset and re-anchor detections across all sources. These are derived signals, not a count of confirmed account resets. Up to 200 recent signals are shown." TextWrapping="Wrap" Opacity="0.7" />
                    <ListView x:Name="ResetList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate><DataTemplate>
                            <Expander Header="{Binding Header}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <TextBlock Text="{Binding Detail}" Opacity="0.7" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Expander>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
