<Page x:Class="TajsTokens.App.Pages.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="16">
<VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState>
                                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1000" /></VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="BurnDetailColumn.Width" Value="1.6*" />
                                        <Setter Target="BurnDetailRow.Height" Value="0" />
                                        <Setter Target="BurnDetails.(Grid.Row)" Value="0" />
                                        <Setter Target="BurnDetails.(Grid.Column)" Value="1" />
                                        <Setter Target="SummaryThirdColumn.Width" Value="*" />
                                        <Setter Target="SummaryFourthColumn.Width" Value="*" />
                                        <Setter Target="SourceSummary.(Grid.Row)" Value="0" />
                                        <Setter Target="SourceSummary.(Grid.Column)" Value="2" />
                                        <Setter Target="ActivitySummary.(Grid.Row)" Value="0" />
                                        <Setter Target="ActivitySummary.(Grid.Column)" Value="3" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Text="Quota burn" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="When your account's reported quota changed. Times are local; details are optional." TextWrapping="Wrap" Opacity="0.7" />
                <TextBlock x:Name="StatusText" Text="Loading quota changes…" TextWrapping="Wrap" Opacity="0.6" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <ComboBox x:Name="RangeCombo" Width="120" SelectedIndex="1" SelectionChanged="OnFilterChanged" AutomationProperties.Name="History range">
                    <ComboBoxItem Content="24 hours" Tag="1" /><ComboBoxItem Content="7 days" Tag="7" />
                    <ComboBoxItem Content="30 days" Tag="30" /><ComboBoxItem Content="90 days" Tag="90" />
                </ComboBox>
                <Button Content="Refresh" Click="OnRefreshClicked" />
            </StackPanel>
        </Grid>
        <Grid x:Name="BurnSummary" Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SummaryThirdColumn" Width="0" /><ColumnDefinition x:Name="SummaryFourthColumn" Width="0" /></Grid.ColumnDefinitions>
            <Border Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6"><TextBlock Text="Changes loaded" Opacity="0.65" /><TextBlock x:Name="BurnIntervalCountText" Text="—" FontSize="24" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6"><TextBlock Text="Largest change" Opacity="0.65" /><TextBlock x:Name="LargestDropText" Text="—" FontSize="24" FontWeight="SemiBold" /></StackPanel>
            </Border>
            <Border x:Name="SourceSummary" Grid.Row="1" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6"><TextBlock Text="Evidence source" Opacity="0.65" /><TextBlock x:Name="ResetCountText" Text="—" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel>
            </Border>
            <Border x:Name="ActivitySummary" Grid.Row="1" Grid.Column="1" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="6"><TextBlock Text="With local activity" Opacity="0.65" /><TextBlock x:Name="CorrelatedIntervalsText" Text="—" FontSize="24" FontWeight="SemiBold" /></StackPanel>
            </Border>
        </Grid>
        <Pivot x:Name="BurnTabs" Grid.Row="2" SelectionChanged="OnTabChanged">
            <PivotItem Header="Usage changes">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Expander Header="Other observations (diagnostics)" IsExpanded="False" VerticalAlignment="Top">
                        <StackPanel Spacing="8" MaxWidth="420">
                        <TextBlock Text="Session logs may repeat the same account change. These observations are kept separately, not added to account usage." TextWrapping="Wrap" />
                        <ComboBox x:Name="SourceFilter" SelectedIndex="0" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Quota evidence source">
                            <ComboBoxItem Content="Account meter · main timeline" /><ComboBoxItem Content="Diagnostic: rollout observations" /><ComboBoxItem Content="Diagnostic: all observations" />
                        </ComboBox>
                        </StackPanel>
                        </Expander>
                        <ComboBox x:Name="BurnWindowFilter" SelectedIndex="0" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Quota window">
                            <ComboBoxItem Content="All windows" /><ComboBoxItem Content="5-hour" /><ComboBoxItem Content="Weekly" />
                        </ComboBox>
                    </StackPanel>
                    <Grid Grid.Row="1" x:Name="BurnLayout" ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="BurnDetailColumn" Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition x:Name="BurnDetailRow" Height="*" /></Grid.RowDefinitions>

                        <Border Padding="8" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <ListView x:Name="BurnIntervalList" SelectionMode="Single" SelectionChanged="OnBurnIntervalSelectionChanged" ScrollViewer.IsDeferredScrollingEnabled="True" AutomationProperties.Name="Quota changes">
                                <ListView.ItemTemplate><DataTemplate>
                                    <StackPanel Padding="8" Spacing="5">
                                        <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Scope}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate></ListView.ItemTemplate>
                            </ListView>
                        </Border>
                        <Border x:Name="BurnDetails" Grid.Row="1" Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock x:Name="SelectedIntervalTitle" Text="Select a quota change" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <StackPanel Grid.Row="1" Spacing="6">
                                    <TextBlock x:Name="SelectedIntervalFacts" Text="Its observed change and local activity will appear here." TextWrapping="Wrap" Opacity="0.7" />
                                    <TextBlock Text="Local activity is context, not proof of what caused the quota change." TextWrapping="Wrap" Opacity="0.6" />
                                </StackPanel>
                                <Expander x:Name="SourceDetails" Grid.Row="2" Header="Observation details and source" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" MaxHeight="180">
                                    <ScrollViewer><TextBlock x:Name="IntervalEvidenceText" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></ScrollViewer>
                                </Expander>
                                <Expander x:Name="ActivityDetails" Grid.Row="3" Header="Local activity during this interval (not quota attribution)" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Top">
                                <ListView x:Name="ContributorList" MaxHeight="300" SelectionMode="None" ScrollViewer.IsDeferredScrollingEnabled="True" AutomationProperties.Name="Local activity in selected interval">
                                    <ListView.ItemTemplate><DataTemplate>
                                        <StackPanel Padding="8" Spacing="6">
                                            <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <ProgressBar Value="{Binding Share}" Minimum="0" Maximum="100" Height="4" />
                                            <TextBlock Text="{Binding Detail}" Opacity="0.7" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate></ListView.ItemTemplate>
                                </ListView>
                                </Expander>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </PivotItem>
            <PivotItem Header="Quota drops &amp; reset times">
                <Grid RowSpacing="12" Padding="4,12,4,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Account-meter drops are shown by default. Times say when a change was observed, not exactly when a reset occurred. Reset-time shifts do not establish quota replenishment. Details are collapsed; up to 200 observations are loaded across sources." TextWrapping="Wrap" Opacity="0.7" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
                    <ComboBox x:Name="ResetSourceFilter" SelectedIndex="1" SelectionChanged="OnResetFilterChanged" AutomationProperties.Name="Reset signal source">
                        <ComboBoxItem Content="All sources · separate" /><ComboBoxItem Content="Account meter" /><ComboBoxItem Content="Rollout readings" /><ComboBoxItem Content="Unknown / mixed" />
                    </ComboBox>
                    <ComboBox x:Name="ResetKindFilter" SelectedIndex="0" SelectionChanged="OnResetFilterChanged" AutomationProperties.Name="Quota change type">
                        <ComboBoxItem Content="Quota drops" /><ComboBoxItem Content="Reset-time shifts" /><ComboBoxItem Content="All observations · diagnostics" />
                    </ComboBox>
                    </StackPanel>
                    <ListView x:Name="ResetList" Grid.Row="2" SelectionMode="None" AutomationProperties.Name="Reset and re-anchor signals">
                        <ListView.ItemTemplate><DataTemplate>
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4">
                                <Expander.Header>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Scope}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander.Header>
                                <TextBlock Text="{Binding Detail}" Opacity="0.7" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Expander>
                        </DataTemplate></ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
