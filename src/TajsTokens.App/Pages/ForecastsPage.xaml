<Page
    x:Class="TajsTokens.App.Pages.ForecastsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Forecasts &amp; scenario planner" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Reset-aware forecast history plus account-local workload scenarios. Predictions stop at the edge of the evidence instead of wandering off into horoscope territory."
                           Opacity="0.72" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock x:Name="StatusText" Text="Loading persisted forecast history…" Opacity="0.72" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <ComboBox x:Name="HistoryRangeCombo" Width="130" SelectedIndex="1">
                    <ComboBoxItem Content="7 days" Tag="7" />
                    <ComboBoxItem Content="30 days" Tag="30" />
                    <ComboBoxItem Content="90 days" Tag="90" />
                    <ComboBoxItem Content="180 days" Tag="180" />
                </ComboBox>
                <Button Content="Refresh" Click="OnRefreshClicked" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="5h forecast samples" Opacity="0.65" />
                    <TextBlock x:Name="FiveHourSamplesText" Text="—" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Weekly forecast samples" Opacity="0.65" />
                    <TextBlock x:Name="WeeklySamplesText" Text="—" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="5h safe-window rate" Opacity="0.65" />
                    <TextBlock x:Name="FiveHourSafeText" Text="—" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Weekly safe-window rate" Opacity="0.65" />
                    <TextBlock x:Name="WeeklySafeText" Text="—" FontSize="22" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Padding="12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Forecast history" FontSize="18" FontWeight="SemiBold" />
                    <ListView x:Name="ForecastList" Grid.Row="1" SelectionMode="None" ScrollViewer.IsDeferredScrollingEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="5" Spacing="2">
                                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Opacity="0.72" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Padding="14" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock Text="Workload scenario" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Uses your observed quota-drop intervals only. Model/reasoning filters are used when enough matching history exists; otherwise confidence is penalized." Opacity="0.68" TextWrapping="Wrap" />

                        <TextBlock Text="Duration (hours)" />
                        <NumberBox x:Name="DurationBox" Value="2" Minimum="0.1" Maximum="168" SpinButtonPlacementMode="Compact" />
                        <TextBlock Text="Root agents" />
                        <NumberBox x:Name="RootAgentsBox" Value="1" Minimum="0" Maximum="32" SpinButtonPlacementMode="Compact" />
                        <TextBlock Text="Subagents" />
                        <NumberBox x:Name="SubagentsBox" Value="0" Minimum="0" Maximum="64" SpinButtonPlacementMode="Compact" />
                        <TextBlock Text="Intensity multiplier" />
                        <NumberBox x:Name="IntensityBox" Value="1" Minimum="0.1" Maximum="5" SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                        <TextBlock Text="Model (optional)" />
                        <TextBox x:Name="ModelBox" PlaceholderText="e.g. gpt-5.6-luna" />
                        <TextBlock Text="Reasoning effort (optional)" />
                        <TextBox x:Name="ReasoningBox" PlaceholderText="e.g. xhigh" />

                        <Button Content="Estimate from history" Click="OnEstimateClicked" HorizontalAlignment="Left" />
                        <InfoBar x:Name="ScenarioInfo" IsOpen="False" IsClosable="False" />
                        <TextBlock x:Name="ScenarioMethodText" Opacity="0.62" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
