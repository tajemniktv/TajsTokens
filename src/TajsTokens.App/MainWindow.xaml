<Window
    x:Class="TajsTokens.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TajsTokens.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="TajsTokens">

    <Grid>
        <NavigationView x:Name="AppNavigation"
                        IsBackButtonVisible="Visible"
                        BackRequested="OnBackRequested"
                        IsSettingsVisible="True"
                        PaneDisplayMode="Auto"
                        OpenPaneLength="208"
                        ExpandedModeThresholdWidth="1200"
                        CompactModeThresholdWidth="700"
                        IsPaneOpen="True"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="overview" Icon="View" IsSelected="True" />
                <NavigationViewItem Content="Codex" Tag="codex" Icon="People" />
                <NavigationViewItem Content="Forecasts" Tag="forecasts" Icon="Preview" />
                <NavigationViewItem Content="Quota history" Tag="analytics" Icon="Document" />
                <NavigationViewItem Content="Advanced" Icon="Repair" SelectsOnInvoked="False">
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Diagnostics" Tag="diagnostics" />
                        <NavigationViewItem Content="Model lab" Tag="model-lab" />
                        <NavigationViewItem Content="Rollout coverage" Tag="coverage" />
                        <NavigationViewItem Content="Native sources" Tag="sources" />
                        <NavigationViewItem Content="Data explorer" Tag="codex-data" />
                        <NavigationViewItem Content="CLI harness" Tag="codex-cli" />
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" CacheSize="6" Navigated="OnNavigated" />
        </NavigationView>
    </Grid>
</Window>
