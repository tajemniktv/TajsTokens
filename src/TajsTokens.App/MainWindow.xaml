<Window
    x:Class="TajsTokens.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TajsTokens.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="TajsTokens">

    <Grid>
        <NavigationView x:Name="AppNavigation"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        PaneDisplayMode="LeftCompact"
                        SelectionChanged="OnNavigationSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Overview" Tag="overview" Icon="View" IsSelected="True" />
                <NavigationViewItem Content="Codex CLI Harness" Tag="codex-cli" Icon="Play" />
                <NavigationViewItem Content="Codex" Tag="codex" Icon="People" />
                <NavigationViewItem Content="Forecasts" Tag="forecasts" Icon="Preview" />
                <NavigationViewItem Content="Quota burn" Tag="analytics" Icon="Document" />
                <NavigationViewItem Content="Diagnostics" Tag="diagnostics" Icon="Repair" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Codex Data Explorer" Tag="codex-data" Icon="ViewAll" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
