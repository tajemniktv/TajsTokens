<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
        <RootNamespace>TajsTokens.App</RootNamespace>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <Platforms>x64;x86;arm64</Platforms>
        <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
        <UseWinUI>true</UseWinUI>

        <!-- Unpackaged WinUI deployment -->
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <EnableMsixTooling>true</EnableMsixTooling>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>

        <!-- Keep WinUI publish conservative -->
        <PublishTrimmed>false</PublishTrimmed>
        <PublishSingleFile>false</PublishSingleFile>
        <PublishReadyToRun>false</PublishReadyToRun>

        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
        <!-- Favor a small retained heap over maximum batch throughput. -->
        <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0"/>
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5"/>
        <PackageReference Include="System.Drawing.Common" Version="10.0.11"/>
    </ItemGroup>

    <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
        <Compile Include="CrossPlatformBuildPlaceholder.cs"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\TajsTokens.Core\TajsTokens.Core.csproj"/>
        <ProjectReference Include="..\TajsTokens.Infrastructure\TajsTokens.Infrastructure.csproj"/>
    </ItemGroup>

    <!-- The existing headless evaluation executable hosts the bounded calibration worker.
         It shares the app's self-contained runtime and libraries; only its four entry files
         are added to output/publish. Its build remains incremental under artifacts/. -->
    <Target Name="PrepareCalibrationWorker" BeforeTargets="CopyFilesToOutputDirectory;ComputeFilesToPublish"
            Condition="'$(OS)' == 'Windows_NT' and '$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <_CalibrationProject>$(MSBuildThisFileDirectory)..\..\tools\TajsTokens.ForecastEvaluation\TajsTokens.ForecastEvaluation.csproj</_CalibrationProject>
            <_CalibrationRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</_CalibrationRid>
            <_CalibrationRid Condition="'$(_CalibrationRid)' == ''">win-$(Platform)</_CalibrationRid>
            <_CalibrationProperties>Configuration=$(Configuration);Platform=AnyCPU;RuntimeIdentifier=$(_CalibrationRid);SelfContained=true;DogfoodEnabled=false</_CalibrationProperties>
        </PropertyGroup>
        <MSBuild Projects="$(_CalibrationProject)" Targets="Restore;Build" Properties="$(_CalibrationProperties)" BuildInParallel="false" />
        <MSBuild Projects="$(_CalibrationProject)" Targets="GetTargetPath" Properties="$(_CalibrationProperties)">
            <Output TaskParameter="TargetOutputs" ItemName="_CalibrationTarget" />
        </MSBuild>
        <ItemGroup>
            <_CalibrationFile Include="@(_CalibrationTarget)" />
            <_CalibrationFile Include="@(_CalibrationTarget->'%(RootDir)%(Directory)%(Filename).exe')" />
            <_CalibrationFile Include="@(_CalibrationTarget->'%(RootDir)%(Directory)%(Filename).deps.json')" />
            <_CalibrationFile Include="@(_CalibrationTarget->'%(RootDir)%(Directory)%(Filename).runtimeconfig.json')" />
            <ResolvedFileToPublish Include="@(_CalibrationFile)" RelativePath="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
        <Copy SourceFiles="@(_CalibrationFile)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    </Target>
</Project>

